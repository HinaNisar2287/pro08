
"use client";

import dynamic from "next/dynamic";
import Link from "next/link";
import { useState } from "react";

import LayerControl from "@/components/LayerControl";
import FeatureDetails from "@/components/FeatureDetails";
import type { GeologicalProperties } from "@/types/geology";

const GeologicalMap = dynamic(
  () => import("@/components/GeologicalMap"),
  {
    ssr: false,
    loading: () => (
      <div className="flex h-full items-center justify-center bg-slate-900 text-slate-400">
        Loading geological map...
      </div>
    ),
  }
);

export default function MapPage() {
  const [layers, setLayers] = useState({
    regions: true,
    formations: true,
    faults: true,
  });

  const [selected, setSelected] =
    useState<GeologicalProperties | null>(null);

  function updateLayer(
    key: "regions" | "formations" | "faults",
    value: boolean
  ) {
    setLayers((previous) => ({
      ...previous,
      [key]: value,
    }));
  }

  return (
    <main className="min-h-screen bg-[#07111f] p-5 text-white">

      <header className="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <Link href="/" className="text-xl font-bold">
            Pakistan <span className="text-sky-400">Geological Atlas</span>
          </Link>

          <p className="mt-1 text-sm text-slate-400">
            Interactive Geological Explorer
          </p>
        </div>

        <Link href="/formations" className="text-sky-400">
          Geological Records →
        </Link>
      </header>

      <h1 className="mb-2 text-2xl font-bold">
        Pakistan Geological Map
      </h1>

      <p className="mb-5 text-sm text-slate-400">
        Explore geographical layers and geological features.
      </p>

      <div className="grid gap-5 xl:grid-cols-[1fr_320px]">

        <div className="h-[600px] overflow-hidden rounded-xl">
          <GeologicalMap
            regions={layers.regions}
            formations={layers.formations}
            faults={layers.faults}
            onSelect={setSelected}
          />
        </div>

        <aside className="space-y-5">
          <LayerControl
            layers={layers}
            onChange={updateLayer}
          />

          <FeatureDetails feature={selected} />

          <div className="rounded-xl border border-slate-700 bg-slate-900 p-5">
            <h2 className="mb-3 font-bold">Map Legend</h2>

            <p className="mb-2 text-sm text-slate-300">
              <span className="mr-2 text-sky-400">●</span>
              Geological Regions
            </p>

            <p className="mb-2 text-sm text-slate-300">
              <span className="mr-2 text-violet-400">●</span>
              Rock Formations
            </p>

            <p className="text-sm text-slate-300">
              <span className="mr-2 text-rose-400">●</span>
              Faults & Structures
            </p>
          </div>
        </aside>

      </div>
    </main>
  );
}
